# Base Application URL
# Local: http://localhost:3000
# Production: https://your-production-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Connection URI (Atlas or Local)
# Example Local: mongodb://localhost:27017/international_day
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/international_day?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/international_day

# Optional: Seed security key to protect POST /api/seed in production
SEED_SECRET=change_this_secret_in_production
